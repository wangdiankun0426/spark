    "@fullcalendar/vue3": "^6.1.14",
    "@kangc/v-md-editor": "^2.3.18",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pptx": "^1.0.1",
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "echarts": "^5.5.0",
    "element-plus": "^2.3.12",
    "pdfjs-dist": "^3.11.174",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5",
    "vuex": "^4.1.0"
  },
