<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.dms.DocumentVersionDao" >
    <sql id="allColumnList" >
        id , doc_id , version_no , name , size , path , ext , delete_flag , created_by , created_dt , updated_by , updated_dt
    </sql>

    <sql id="searchCondition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="docId != null">
            and doc_id = #{docId}
        </if>
        <if test="versionNo != null">
            and version_no = #{versionNo}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <sql id="sortCondition">
        <choose>
            <when test="sorts != null and sorts.size() > 0">
                <foreach item="value" index="key" collection="sorts.entrySet()" separator=",">
                    ${value}
                </foreach>
            </when>
            <otherwise>
                version_no desc
            </otherwise>
        </choose>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into dms_document_version ( doc_id , version_no , name , size , path , ext , delete_flag , created_by , created_dt , updated_by , updated_dt)
        values ( #{docId} , #{versionNo} , #{name} , #{size} , #{path} , #{ext} , 1, #{createdBy}, #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

    <update id="deleteById">
        update dms_document_version set delete_flag = -1 , updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        where id = #{id}
    </update>

    <update id="updateById">
        update dms_document_version set updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        <if test="name != null and name != ''">
            , name = #{name}
        </if>
        where id = #{id}
    </update>

    <select id="queryDocumentVersionCount" resultType="java.lang.Integer">
        select count(1)
        from dms_document_version
        where 1 = 1
        <include refid="searchCondition"/>
        ${dataScopeSQL}
    </select>

    <select id="queryDocumentVersionList" resultType="com.spark.common.bean.dms.result.DocumentVersionResult">
        select <include refid="allColumnList"/>
        from dms_document_version
        where 1 = 1
        <include refid="searchCondition"/>
        ${dataScopeSQL}
        order by
        <include refid="sortCondition"/>
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryDocumentVersion" resultType="com.spark.common.bean.dms.result.DocumentVersionResult">
        select <include refid="allColumnList"/>
        from dms_document_version
        where 1=1
        <include refid="searchCondition"/>
        limit 1
    </select>
</mapper>
