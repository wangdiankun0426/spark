<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.flow.FlowTemplateDao" >
    <sql id="allColumnList" >
        id , name , process_id , form_id, type, rev_num , rev_id, status, remark , delete_flag , created_by , created_dt , updated_by , updated_dt
    </sql>

    <sql id="searchCondition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="processId != null and processId != ''">
            and process_id = #{processId}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        <if test="type != null">
            and type = #{type}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <sql id="sortCondition">
        <choose>
            <when test="sorts != null and sorts.size() > 0">
                <foreach item="value" index="key" collection="sorts.entrySet()" separator=",">
                    ${value}
                </foreach>
            </when>
            <otherwise>
                id desc
            </otherwise>
        </choose>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into flow_template ( id, name , process_id , form_id , type , rev_num , rev_id, status, remark , dept_id , delete_flag , created_by , created_dt , updated_by , updated_dt)
        values (#{id} , #{name} , #{processId} , #{formId} , #{type} , #{revNum} , #{revId} , #{status} , #{remark} , #{deptId} , 1, #{createdBy}, #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

    <update id="deleteById">
        update flow_template set delete_flag = -1 , updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        where id = #{id}
    </update>

    <update id="updateById">
        update flow_template  set updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        <if test="name != null and name != ''">
            , name = #{name}
        </if>
        <if test="processId != null and processId != ''">
            , process_id = #{processId}
        </if>
        <if test="formId != null">
            , form_id = #{formId}
        </if>
        <if test="revNum != null">
            , rev_num = #{revNum}
        </if>
        <if test="revId != null">
            , rev_id = #{revId}
        </if>
        <if test="status != null">
            , status = #{status}
        </if>
        <if test="type != null">
            , type = #{type}
        </if>
        <if test="remark != null">
            , remark = #{remark}
        </if>
        where id = #{id}
    </update>

    <select id="queryTemplateCount" resultType="java.lang.Integer">
        select count(1)
        from flow_template
        where 1 = 1
        <include refid="searchCondition"/>
        ${dataScopeSQL}
    </select>

    <select id="queryTemplateList" resultType="com.spark.common.bean.flow.result.FlowTemplateResult">
        select <include refid="allColumnList"/>
        from flow_template
        where 1 = 1
        <include refid="searchCondition"/>
        ${dataScopeSQL}
        order by
        <include refid="sortCondition"/>
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryTemplate" resultType="com.spark.common.bean.flow.result.FlowTemplateResult">
        select <include refid="allColumnList"/>
        from flow_template
        where 1=1
        <include refid="searchCondition"/>
        limit 1
    </select>
</mapper>
