<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.chat.ChatSpaceDao" >
    <sql id="Base_Column_List" >
    id, space_id, sender_id,receiver_id, delete_flag,created_by, created_dt, updated_by, updated_dt
    </sql>

    <sql id="condition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="spaceId != null">
            and space_id = #{spaceId}
        </if>
        <if test="senderId != null">
            and sender_id = #{senderId}
        </if>
        <if test="receiverId != null">
            and receiver_id = #{receiverId}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <select id="queryChatSpaceList" resultType="com.spark.common.bean.chat.result.ChatSpaceResult">
        select <include refid="Base_Column_List"/>
        from chat_space
        where 1=1
        <include refid="condition"/>
    </select>

    <select id="queryChatSpace" resultType="com.spark.common.bean.chat.result.ChatSpaceResult">
        select <include refid="Base_Column_List"/>
        from chat_space
        where 1=1
        <include refid="condition"/>
        limit 1
    </select>

    <insert id="insert">
        insert into chat_space (space_id, sender_id,receiver_id, delete_flag,created_by, created_dt, updated_by, updated_dt)
        values (#{spaceId}, #{senderId}, #{receiverId}, 1, #{createdBy} , #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

</mapper>
