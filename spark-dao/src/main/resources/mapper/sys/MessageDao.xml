<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.sys.MessageDao" >
    <sql id="allColumnList" >
     id , type , title , content , ref_id, delete_flag ,created_by ,created_dt , updated_by , updated_dt
    </sql>

    <sql id="condition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="type != null ">
            and type = #{type}
        </if>
        <if test="title != null  and  title != '' ">
            and title like concat('%', #{title}, '%')
        </if>
        <if test="content != null  and  content != '' ">
            and content = #{content}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into sys_message ( type , title , content , ref_id, delete_flag , created_by , created_dt , updated_by , updated_dt)
        values ( #{type} , #{title} , #{content} , #{refId}, 1, #{createdBy}, #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

    <update id="deleteById">
        update sys_message set delete_flag = -1 , updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        where id = #{id}
    </update>

    <update id="updateById">
        update sys_message  set updated_by = #{updatedBy} , updated_dt = #{updatedDt}
        <if test="type != null">
            , type = #{type}
        </if>
        <if test="title != null">
            , title = #{title}
        </if>
        <if test="content != null">
            , content = #{content}
        </if>
        where id = #{id}
    </update>

    <select id="queryMessageCount" resultType="java.lang.Integer">
        select count(1)
        from sys_message
        where 1 = 1
        <include refid="condition"/>
    </select>

    <select id="queryMessageList" resultType="com.spark.common.bean.sys.result.MessageResult">
        select <include refid="allColumnList"/>
        from sys_message
        where 1 = 1
        <include refid="condition"/>
        order by id desc
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryMessage" resultType="com.spark.common.bean.sys.result.MessageResult">
        select <include refid="allColumnList"/>
        from sys_message
        where 1=1
        <include refid="condition"/>
        limit 1
    </select>
</mapper>
