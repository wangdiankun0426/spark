<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.sys.RoleUserDao" >
    <sql id="Base_Column_List" >
    id, role_id, user_id, delete_flag,created_by, created_dt, updated_by, updated_dt
    </sql>

    <sql id="condition">
        <if test="roleId != null">
            and role_id = #{roleId}
        </if>
        <if test="roleIds != null and roleIds.size() > 0">
            and role_id in (
            <foreach collection="roleIds" item="roleId" separator=",">
                #{roleId}
            </foreach>
            )
        </if>
        <if test="userIds != null and userIds.size() > 0">
            and user_id in (
            <foreach collection="userIds" item="userId" separator=",">
                #{userId}
            </foreach>
            )
        </if>
        <if test="userId != null">
            and user_id = #{userId}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <select id="queryRoleUserList" resultType="com.spark.common.bean.sys.result.RoleUserResult">
        select <include refid="Base_Column_List"/>
        from sys_role_user
        where 1=1
        <include refid="condition"/>
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryRoleUserCount" resultType="java.lang.Integer">
        select count(1)
        from sys_role_user
        where 1=1
        <include refid="condition"/>
    </select>

    <insert id="batchInsertByRoleId">
        insert into sys_role_user (role_id, user_id, delete_flag,created_by, created_dt, updated_by, updated_dt)
        values
        <foreach collection="userIds" item="userId" separator=",">
            (#{roleId}, #{userId}, 1, #{createdBy}, now(), #{createdBy}, now())
        </foreach>
    </insert>

    <insert id="batchInsertByUserId">
        insert into sys_role_user (role_id, user_id, delete_flag,created_by, created_dt, updated_by, updated_dt)
        values
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{roleId}, #{userId}, 1, #{createdBy}, now(), #{createdBy}, now())
        </foreach>
    </insert>
</mapper>
