<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.sys.TenantConfigDao" >
    <sql id="Base_Column_List" >
     id , tenant_id , name , `key` , `value` , delete_flag , created_by , created_dt , updated_by , updated_dt
    </sql>

    <sql id="condition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="tenantId != null">
            and tenant_id = #{tenantId}
        </if>
        <if test="name != null">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="key != null">
            and `key` = #{key}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <!-- 普通记录表：数据库自增 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into sys_tenant_config ( tenant_id , name , `key` , `value` , delete_flag , created_by , created_dt , updated_by , updated_dt )
        values (#{tenantId}, #{name}, #{key}, #{value}, 1, #{createdBy}, #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

    <update id="updateById">
        update sys_tenant_config
        set updated_by = #{updatedBy}, updated_dt = #{updatedDt}
        <if test="name != null">
            ,name = #{name}
        </if>
        <if test="value != null">
            ,`value` = #{value}
        </if>
        <if test="value == null">
            ,`value` = null
        </if>
        where id = #{id}
    </update>

    <update id="deleteById">
        update sys_tenant_config
        set delete_flag = -1, updated_by = #{updatedBy}, updated_dt = #{updatedDt}
        where id = #{id}
    </update>

    <select id="queryTenantConfigList" resultType="com.spark.common.bean.sys.result.TenantConfigResult">
        select <include refid="Base_Column_List"/>
        from sys_tenant_config
        where 1=1
        <include refid="condition"/>
        order by id
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryTenantConfig" resultType="com.spark.common.bean.sys.result.TenantConfigResult">
        select <include refid="Base_Column_List"/>
        from sys_tenant_config
        where 1=1
        <include refid="condition"/>
        limit 1
    </select>

    <select id="queryTenantConfigCount" resultType="java.lang.Integer">
        select count(1)
        from sys_tenant_config
        where 1=1
        <include refid="condition"/>
    </select>
</mapper>
