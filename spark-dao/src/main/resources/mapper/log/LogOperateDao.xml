<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.log.LogOperateDao" >
    <sql id="Base_Column_List" >
      id , type , obj_id, code , consume , remark , delete_flag , created_by , created_dt , updated_by , updated_dt
    </sql>

    <sql id="condition">
        <if test="type != null ">
            AND type = #{type}
        </if>
        <if test="objId != null ">
            AND obj_id = #{objId}
        </if>
        <if test="code != null ">
            AND code = #{code}
        </if>
        <if test="createdStartTime != null ">
            AND created_dt > #{createdStartTime}
        </if>
        <if test="createdEndTime != null ">
            AND #{createdEndTime} > created_dt
        </if>
        <if test="createdBy != null ">
            AND created_by = #{createdBy}
        </if>
    </sql>

    <insert id="insert" parameterType="com.spark.common.bean.log.entity.LogOperate">
        insert into log_operate (type , obj_id , code , consume , remark , delete_flag , created_by , created_dt , updated_by , updated_dt)
        values (#{type}, #{objId}, #{code}, #{consume}, #{remark}, 1 , #{createdBy}, now(), #{updatedBy}, now())
    </insert>

    <select id="queryLogOperateList" resultType="com.spark.common.bean.log.result.LogOperateResult">
        select <include refid="Base_Column_List"/>
        from log_operate
        where 1=1
        <include refid="condition"/>
        order by id desc
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryLogOperateCount" resultType="java.lang.Integer">
        select count(1)
        from log_operate
        where 1=1
        <include refid="condition"/>
    </select>
</mapper>
