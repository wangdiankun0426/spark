<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.spark.dao.form.FormVersionDao" >
    <sql id="allColumnList" >
     id , form_id , rev_code , rev_num, file_path , delete_flag , created_by , created_dt , updated_by , updated_dt
    </sql>

    <sql id="searchCondition">
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="ids != null and ids.size() > 0">
            and id in (
            <foreach collection="ids" item="id" separator=",">
                #{id}
            </foreach>
            )
        </if>
        <if test="formId != null">
            and form_id = #{formId}
        </if>
        <if test="deleteFlag != null and id == null and ids == null">
            and delete_flag = #{deleteFlag}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into form_version (form_id , rev_code , rev_num , file_path , delete_flag , created_by , created_dt , updated_by , updated_dt)
        values (#{formId} , #{revCode} , #{revNum}  , #{filePath} , 1, #{createdBy}, #{createdDt}, #{updatedBy}, #{updatedDt})
    </insert>

    <select id="queryFormVersion" resultType="com.spark.bean.form.result.FormVersionResult">
        select <include refid="allColumnList"/>
        from form_version
        where 1=1
        <include refid="searchCondition"/>
        limit 1
    </select>

    <select id="queryFormVersionList" resultType="com.spark.bean.form.result.FormVersionResult">
        select <include refid="allColumnList"/>
        from form_version
        where 1=1
        <include refid="searchCondition"/>
        <if test="page == true">
            limit #{startRow}, #{pageSize}
        </if>
    </select>

    <select id="queryFormVersionCount" resultType="java.lang.Integer">
        select count(1)
        from form_version
        where 1=1
        <include refid="searchCondition"/>
    </select>
</mapper>
